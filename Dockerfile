# -----------------------------
# Stage 1: Build Frontend
# -----------------------------
FROM node:20-alpine3.20 AS frontend-builder

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

# Build the frontend application
# Set API URL to /api for the production build
ENV VITE_API_URL=/api
RUN npm run build

# -----------------------------
# Stage 2: Build Backend
# -----------------------------
FROM node:20-alpine3.20 AS backend-builder

WORKDIR /app/backend

COPY backend/package*.json ./
RUN npm ci

COPY backend/ ./

# Build the backend application
RUN npm run build:ts

# -----------------------------
# Stage 3: Final Image with Nginx
# -----------------------------
FROM nginx:1.28-alpine-slim

# Set environment variables
ENV NODE_ENV=production \
    DATABASE_PATH=/app/data/crontabs.db \
    MIGRATIONS_PATH=/app/backend/src/migrations \
    CRON_IN_DOCKER=true \
    CRON_PATH=/etc/cron.d

RUN apk add --no-cache \
    bash \
    supervisor \
    curl \
    nodejs \
    npm \
    dcron \
    tzdata \
    docker-cli

ENV PATH="/usr/bin/docker:${PATH}"

RUN mkdir -p /app/backend /var/log/supervisor ${CRON_PATH} /var/log/crontabs /app/data /etc/supervisor/conf.d /app/scripts

# Set permissions for cron directories
RUN chmod 755 ${CRON_PATH}
RUN chmod 755 /var/log/crontabs

# Create root cron file with proper header and permissions
RUN echo '# Root cron file for application' > /etc/cron.d/root && \
    echo '# DO NOT EDIT THIS FILE MANUALLY - It is managed by the application' >> /etc/cron.d/root && \
    echo '# Format: minute hour day month weekday command' >> /etc/cron.d/root && \
    echo "# Last updated: $(date -Iseconds)" >> /etc/cron.d/root && \
    echo '' >> /etc/cron.d/root && \
    echo '# Test cron job' >> /etc/cron.d/root && \
    echo '* * * * * echo "Cron is working at $(date)" >> /var/log/crontabs/cron-test.log 2>&1' >> /etc/cron.d/root && \
    echo '' >> /etc/cron.d/root && \
    chmod 644 /etc/cron.d/root

# Copy the frontend from the frontend-builder stage
COPY --from=frontend-builder /app/frontend/dist /usr/share/nginx/html/crondiwa

# Copy Nginx configuration
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Copy supervisor configuration
COPY supervisor/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Copy backend package files and install dependencies
WORKDIR /app/backend
COPY backend/package*.json ./
RUN npm ci --only=production && npm install -g fastify-cli

# Copy built backend files
COPY --from=backend-builder /app/backend/dist ./dist
COPY --from=backend-builder /app/backend/src/migrations ./src/migrations

# Expose Nginx port
EXPOSE 8000

# Set the entrypoint to our startup script
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]